# SMART BIN LTD - ENVIRONMENT VARIABLES
# Copy this to .env and fill in real values

ENV=development
API_PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartbin
DB_USER=smartbin
DB_PASSWORD=your-mysql-password

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

COMPANY_NAME=Smart Bin Ltd
COMPANY_PAYBILL=4060083
COMPANY_PHONE=0721482110
COMPANY_EMAIL=info@smartbin.co.ke
COMPANY_ADDRESS=Nairobi, Kenya

AFRICASTALKING_API_KEY=your-api-key
AFRICASTALKING_USERNAME=your-username
AFRICASTALKING_SENDER_ID=SMARTBIN

MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=4060083
MPESA_PASSKEY=your-passkey
MPESA_ENVIRONMENT=sandbox
MPESA_VALIDATION_URL=http://localhost:8000/api/payments/validate
MPESA_CONFIRMATION_URL=http://localhost:8000/api/payments/confirm
